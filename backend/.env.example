# ====================================================================
# AI TEXT SUMMARIZER - BACKEND ENVIRONMENT CONFIGURATION
# ====================================================================

# Google Gemini API Key
# Obtain an official key at: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier
# Recommended: gemini-2.5-flash (fast & accurate) or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Port (defaults to 5000)
PORT=5000

# Allowed CORS Origins (comma-separated for dev servers)
CLIENT_URL=http://localhost:5174,http://localhost:5173

# Future MongoDB Database Integration (planned for next milestone)
MONGODB_URI=mongodb://localhost:27017/aitextsummarizer
